{
  "name": "recruitzaa-fe",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "web:build": "npm run build --prefix web",
    "web:deploy": "npm run deploy --prefix web"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "web/src/**/*.{js,jsx,ts,tsx}": [
      "bash -c 'cd web && npx eslint --fix'",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
