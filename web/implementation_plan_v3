export const adminService = {
  getStats: ()                          => api.get<AdminStats>('/admin/stats/'),
  getPendingJobs: (params)              => api.get<PaginatedResponse<Job>>('/admin/jobs/pending/', { params }),
  approveJob: (jobId: string)           => api.patch(`/admin/jobs/${jobId}/approve/`),
  rejectJob: (jobId: string, reason: string) => api.patch(`/admin/jobs/${jobId}/reject/`, { reason }),
  getCompanies: (params)                => api.get<PaginatedResponse<Company>>('/admin/companies/', { params }),
  createCompany: (data: CompanyPayload) => api.post<Company>('/admin/companies/', data),
  updateCompany: (id, data)             => api.patch<Company>(`/admin/companies/${id}/`, data),
  verifyCompany: (id: string)           => api.patch(`/admin/companies/${id}/verify/`),
  getUsers: (params)                    => api.get<PaginatedResponse<AppUser>>('/admin/users/', { params }),
  updateUserRole: (uid, role)           => api.patch(`/admin/users/${uid}/role/`, { role }),
  suspendUser: (uid: string)            => api.patch(`/admin/users/${uid}/suspend/`),
};
